#!/bin/sh
set -eu

remote_name="${1:-}"
zero='0000000000000000000000000000000000000000'
blocked=0

while read -r _local_ref local_oid remote_ref _remote_oid; do
    : "${_local_ref}" "${_remote_oid}"
    case "${remote_ref}" in
        refs/heads/main|refs/heads/master)
            echo "Direct pushes to ${remote_ref#refs/heads/} are blocked. Use a pull request." >&2
            blocked=1
            ;;
        refs/heads/agent/*)
            if [ "${local_oid}" != "${zero}" ]; then
                if ! git merge-base --is-ancestor refs/remotes/origin/main "${local_oid}"; then
                    echo "${remote_ref#refs/heads/} is not based on the current origin/main." >&2
                    blocked=1
                fi
            fi
            ;;
        refs/heads/*)
            echo "Remote branch ${remote_ref#refs/heads/} is not allowed. Use agent/<description>." >&2
            blocked=1
            ;;
        refs/tags/*)
            tag="${remote_ref#refs/tags/}"
            if ! printf '%s' "${tag}" | grep -Eq '^(panel-)?v[0-9]+\.[0-9]+\.[0-9]+$'; then
                echo "Tag ${tag} is not an approved release tag." >&2
                blocked=1
            elif [ "${local_oid}" = "${zero}" ]; then
                echo 'Release tag deletion through ordinary push is blocked.' >&2
                blocked=1
            else
                commit="$(git rev-parse "${local_oid}^{commit}")"
                if ! git merge-base --is-ancestor "${commit}" refs/remotes/origin/main; then
                    echo "Release tag ${tag} does not point to origin/main history." >&2
                    blocked=1
                fi
            fi
            ;;
        *)
            echo "Unsupported push destination ${remote_ref}." >&2
            blocked=1
            ;;
    esac
done

if [ "${remote_name}" != 'origin' ]; then
    echo "Push remote ${remote_name:-<unknown>} is blocked; the approved remote is origin." >&2
    blocked=1
fi

exit "${blocked}"
